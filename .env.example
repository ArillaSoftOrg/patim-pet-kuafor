# Copy to .env.local and fill in real values. Never commit real values.

# Canonical site origin (no trailing slash). Required in production;
# falls back to http://localhost:3000 in local development if unset.
SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (Project Settings → API Keys → Secret keys; a legacy
# service_role key also works). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# Used solely by the booking Server Action to create appointments via
# public.create_appointment(); without it, appointment requests fail safely.
SUPABASE_SECRET_KEY=

# Messaging feature flags (see src/lib/messaging/featureFlags.ts). Every
# flag defaults to false/unset: no notification or marketing-consent UI
# appears, and nothing is ever sent, until a messaging package is actually
# purchased and these are explicitly set to "true" for a deployment.
# Setting any of these does NOT connect a real SMS/WhatsApp/email provider
# — that integration is still future work (see the architecture's own
# README/report for what's left to wire up).
NEXT_PUBLIC_SERVICE_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_MARKETING_CONSENT_ENABLED=false
NEXT_PUBLIC_MARKETING_AUTOMATION_ENABLED=false
